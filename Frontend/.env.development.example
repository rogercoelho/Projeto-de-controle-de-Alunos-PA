# Use quando quiser que o frontend local chame a API local.
# A API local, por sua vez, conecta no MySQL remoto configurado em Api-PA/.env.
VITE_API_URL=http://localhost:8081

# Se quiser usar a API publicada no servidor, remova essa variavel ou use:
# VITE_API_URL=https://api2.plantandoalegria.com.br
